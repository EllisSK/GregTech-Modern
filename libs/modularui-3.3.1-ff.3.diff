diff --git a/src/main/java/brachy/modularui/core/mixins/jei/IngredientListOverlayAccessor.java b/src/main/java/brachy/modularui/core/mixins/jei/IngredientListOverlayAccessor.java
new file mode 100644
index 0000000..f2561ce
--- /dev/null
+++ b/src/main/java/brachy/modularui/core/mixins/jei/IngredientListOverlayAccessor.java
@@ -0,0 +1,14 @@
+package brachy.modularui.core.mixins.jei;
+
+import mezz.jei.gui.input.GuiTextFieldFilter;
+import mezz.jei.gui.overlay.IngredientListOverlay;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.gen.Accessor;
+
+// JEI 19.64 has no SearchInputLayer#focus (added in JEI 19.70), so JeiScreenHandler focuses the search field itself
+@Mixin(value = IngredientListOverlay.class, remap = false)
+public interface IngredientListOverlayAccessor {
+
+    @Accessor("searchField")
+    GuiTextFieldFilter getSearchField();
+}
diff --git a/src/main/java/brachy/modularui/integration/jei/handler/JeiScreenHandler.java b/src/main/java/brachy/modularui/integration/jei/handler/JeiScreenHandler.java
index 5eed946..fa749f5 100755
--- a/src/main/java/brachy/modularui/integration/jei/handler/JeiScreenHandler.java
+++ b/src/main/java/brachy/modularui/integration/jei/handler/JeiScreenHandler.java
@@ -2,6 +2,7 @@ package brachy.modularui.integration.jei.handler;
 
 import brachy.modularui.api.IMuiScreen;
 import brachy.modularui.api.widget.IWidget;
+import brachy.modularui.core.mixins.jei.IngredientListOverlayAccessor;
 import brachy.modularui.integration.jei.GhostIngredientTarget;
 import brachy.modularui.integration.jei.JeiRecipeViewerSlot;
 import brachy.modularui.integration.jei.ModularUIJeiPlugin;
@@ -138,7 +139,8 @@ public class JeiScreenHandler<T extends Screen & IMuiScreen> extends RecipeViewe
         // only set the search field state if it's JEI's actual search field and not JEMI
         if (ModularUIJeiPlugin.getRuntime().getIngredientListOverlay() instanceof IngredientListOverlay realOverlay) {
             if (focused) {
-                realOverlay.getSearchInputLayer().focus();
+                // JEI 19.64's SearchInputLayer has no focus() (JEI 19.70 added it); focus its text field directly
+                ((IngredientListOverlayAccessor) realOverlay).getSearchField().setFocused(true);
             } else {
                 realOverlay.getSearchInputLayer().clearFocus();
             }
diff --git a/src/main/resources/modularui.mixins.json b/src/main/resources/modularui.mixins.json
index e7efc54..586b7e2 100755
--- a/src/main/resources/modularui.mixins.json
